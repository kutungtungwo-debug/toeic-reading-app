@using System.Globalization
@using ToeicApp.Web.Startup
@using ToeicApp.Web.Models
@model HomeDashboardViewModel
@{
    ViewBag.Title = "Tổng quan";
    ViewBag.CurrentPageName = PageNames.Home;
    var updatedAt = DateTime.Now.ToString("HH:mm · dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"));
}

<section class="console-page">
    <div class="console-page-heading">
        <div>
            <h1>Tổng quan</h1>
            <p>Theo dõi kho đề TOEIC Reading và hoạt động làm bài của học viên.</p>
        </div>
        <a class="console-button console-button-primary" href="@Url.Action("Index", "Exams", new { import = true })">
            <img src="~/img/admin/upload-alt.svg" alt="" />
            <span>Import đề thi</span>
        </a>
    </div>

    <div class="console-stat-grid">
        <article class="console-stat-card">
            <div class="console-stat-label">
                <span>Tổng số đề thi</span>
                <img src="~/img/admin/files-alt.svg" alt="" />
            </div>
            <strong>@Model.TotalExams</strong>
            <span class="console-stat-caption">@Model.PublishedExams đã xuất bản · @Model.DraftExams bản nháp</span>
        </article>
        <article class="console-stat-card">
            <div class="console-stat-label">
                <span>Đề đã xuất bản</span>
                <img src="~/img/admin/circle-check.svg" alt="" />
            </div>
            <strong>@Model.PublishedExams</strong>
            <span class="console-stat-caption">Sẵn sàng cho học viên làm bài</span>
        </article>
        <article class="console-stat-card">
            <div class="console-stat-label">
                <span>Đề bản nháp</span>
                <img src="~/img/admin/file-pen-line.svg" alt="" />
            </div>
            <strong>@Model.DraftExams</strong>
            <span class="console-stat-caption">Tiếp tục hoàn thiện trước khi xuất bản</span>
        </article>
        <article class="console-stat-card" id="attempts-summary">
            <div class="console-stat-label">
                <span>Lượt làm bài</span>
                <img src="~/img/admin/users.svg" alt="" />
            </div>
            <strong>@Model.TotalAttempts.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</strong>
            <span class="console-stat-caption console-stat-caption-positive">+@Model.RecentAttempts lượt trong 7 ngày qua</span>
        </article>
    </div>

    <section class="console-section">
        <div class="console-section-heading">
            <h2>Đề thi gần đây</h2>
            <span>Cập nhật lúc @updatedAt</span>
        </div>
        <div class="console-table-card">
            <div class="console-table-scroll">
                <table class="console-table">
                    <thead>
                        <tr>
                            <th class="console-exam-name-column">Tên đề thi</th>
                            <th>Số câu</th>
                            <th>Thời gian</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentExams.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="console-empty-cell">
                                    Chưa có đề thi. Import file Word để bắt đầu tạo đề mới.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var exam in Model.RecentExams)
                            {
                                <tr>
                                    <td class="console-exam-name-column">
                                        <a class="console-exam-title" href="@Url.Action("Preview", "Exams", new { id = exam.Id })">@exam.Title</a>
                                        <span class="console-exam-subtitle">Đề @exam.Id.ToString("D2") · Reading · Part 5, 6, 7</span>
                                    </td>
                                    <td>@exam.TotalQuestions</td>
                                    <td>@exam.DurationMinutes phút</td>
                                    <td>
                                        @if (exam.IsPublished)
                                        {
                                            <span class="console-status console-status-published"><i></i>Đã xuất bản</span>
                                        }
                                        else
                                        {
                                            <span class="console-status console-status-draft"><i></i>Bản nháp</span>
                                        }
                                    </td>
                                    <td class="console-date-cell">
                                        <span>@exam.CreationTime.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                        <small>@exam.CreationTime.ToLocalTime().ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <div class="console-row-actions">
                                            <a class="console-icon-button" href="@Url.Action("Preview", "Exams", new { id = exam.Id })" title="Xem và chỉnh sửa đề thi" aria-label="Xem và chỉnh sửa đề thi">
                                                <img src="~/img/admin/eye.svg" alt="" />
                                            </a>
                                            <button class="console-icon-button btn-toggle-publish" type="button" data-id="@exam.Id" data-published="@(exam.IsPublished ? "true" : "false")" title="@(exam.IsPublished ? "Gỡ xuất bản" : "Xuất bản")" aria-label="@(exam.IsPublished ? "Gỡ xuất bản" : "Xuất bản")">
                                                <img src="@(exam.IsPublished ? Url.Content("~/img/admin/send-muted.svg") : Url.Content("~/img/admin/send.svg"))" alt="" />
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="console-table-footer">
                <span>Hiển thị @Model.RecentExams.Count đề được cập nhật gần nhất</span>
                <a href="@Url.Action("Index", "Exams")">Xem tất cả đề thi <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>

    <div class="console-workspace-grid">
        <section class="console-work-card">
            <h2><img src="~/img/admin/file-pen-line-alt.svg" alt="" />Tiếp tục hoàn thiện đề thi</h2>
            @if (Model.LatestDraft == null)
            {
                <div class="console-work-card-content">
                    <div>
                        <strong>Không có đề bản nháp</strong>
                        <span>Tạo đề mới bằng cách import tài liệu Word.</span>
                    </div>
                    <a class="console-button console-button-outline" href="@Url.Action("Index", "Exams", new { import = true })">
                        <img src="~/img/admin/arrow-right.svg" alt="" />
                        <span>Tạo đề mới</span>
                    </a>
                </div>
            }
            else
            {
                <div class="console-work-card-content">
                    <div>
                        <strong>@Model.LatestDraft.Title</strong>
                        <span>@Model.LatestDraft.TotalQuestions câu · @Model.LatestDraft.DurationMinutes phút · Bản nháp tạo lúc @Model.LatestDraft.CreationTime.ToLocalTime().ToString("HH:mm")</span>
                    </div>
                    <a class="console-button console-button-outline" href="@Url.Action("Preview", "Exams", new { id = Model.LatestDraft.Id })">
                        <img src="~/img/admin/arrow-right.svg" alt="" />
                        <span>Mở chỉnh sửa</span>
                    </a>
                </div>
            }
        </section>
        <aside class="console-work-card console-publish-note">
            <span class="console-status console-status-published"><i></i>Kiểm tra trước xuất bản</span>
            <p>Chỉ xuất bản đề đủ 100 câu, 4 lựa chọn và 1 đáp án đúng cho mỗi câu.</p>
            <span>Part 5: 30 · Part 6: 16 · Part 7: 54</span>
        </aside>
    </div>
</section>

@section scripts
{
    <script>
        $(function () {
            $('.btn-toggle-publish').on('click', function () {
                var button = $(this);
                var examId = button.data('id');
                var isPublished = button.data('published') === true || button.data('published') === 'true';
                var nextState = !isPublished;
                var action = nextState ? 'xuất bản' : 'gỡ xuất bản';

                abp.message.confirm('Bạn có chắc chắn muốn ' + action + ' đề thi này?', 'Xác nhận', function (confirmed) {
                    if (!confirmed) {
                        return;
                    }

                    abp.ui.setBusy();
                    $.ajax({
                        url: '@Url.Action("SetPublished", "Exams")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ id: examId, isPublished: nextState }),
                        success: function (response) {
                            abp.ui.clearBusy();
                            if (response.success) {
                                abp.notify.success('Cập nhật trạng thái đề thi thành công.');
                                window.location.reload();
                            } else {
                                abp.message.error(response.message || 'Không thể cập nhật trạng thái đề thi.');
                            }
                        },
                        error: function () {
                            abp.ui.clearBusy();
                            abp.message.error('Không thể kết nối đến máy chủ.');
                        }
                    });
                });
            });
        });
    </script>
}
